# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Neon PostgreSQL with connection pooling & SSL required)
DATABASE_URL=postgresql://user:password@hostname:5432/eduinsight?sslmode=require

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_access_key_min32chars_replace_in_env
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min32chars_replace_in_env
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# OpenAI AI Engine
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
