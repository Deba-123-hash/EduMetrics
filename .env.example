# ==========================================
# EduInsight AI - Root Environment Variables Example
# ==========================================
# Copy this file to respective client/.env and server/.env files.
# NEVER commit real .env files to version control!

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (Neon PostgreSQL)
# Example: postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/eduinsight?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/eduinsight?sslmode=require

# JWT Authentication Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min32chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# OpenAI AI Engine Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Client Configuration
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=EduInsight AI
